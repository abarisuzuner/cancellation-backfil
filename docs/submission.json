{
  "appName": "Cancellation Backfill",
  "baseUrl": "https://abarisuzuner.github.io/cancellation-backfil/",
  "auth": {
    "required": false,
    "loginPath": "",
    "username": "",
    "password": "",
    "usernameSelector": "",
    "passwordSelector": "",
    "submitSelector": "",
    "successUrlPattern": "",
    "successText": []
  },
  "globalRules": {
    "maxStepTimeSeconds": 45,
    "waitForNetworkIdle": false,
    "notes": [
      "The supplied APP DETAILS still has a null demoUrl. This contract uses the live project URL previously supplied and verified. Set submission.demoUrl to https://abarisuzuner.github.io/cancellation-backfil/ before submitting.",
      "Use a dedicated browser context containing only disposable sample data. Each workflow resets the fictional clinic through its own controls.",
      "Preserve localStorage throughout each workflow. Staff screens and patient previews must run in the same browser context.",
      "Keep navigation on https://abarisuzuner.github.io and preserve the /cancellation-backfil/ path prefix.",
      "Query parameters in persistence checks force document navigation without clearing saved records.",
      "Offers expire after two minutes. Execute offer creation and acceptance promptly. Test expiry with the simulated clock control.",
      "Elapsed booking time varies. Verify the saved patient, booking status, and estimated appointment value instead of an exact duration.",
      "The availability assistant is a deterministic local parser. The demo does not connect to live AI, Oracle persistence, external messaging, or shared records across devices."
    ]
  },
  "workflows": [
    {
      "id": "guided-cancellation-to-confirmed-booking",
      "name": "Recover a cancelled appointment",
      "purpose": "Prove that the guided workflow filters and ranks patients, produces an accepted replacement booking, and preserves the result after navigation.",
      "startPath": "/cancellation-backfil/#settings",
      "steps": [
        {
          "action": "goto",
          "value": "/cancellation-backfil/#settings"
        },
        {
          "action": "click",
          "selector": "button[data-action='reset']"
        },
        {
          "action": "click",
          "selector": "dialog[open] form[data-form='reset'] button[type='submit']"
        },
        {
          "action": "assertVisible",
          "selector": "#recovery-journey[data-state='booked']"
        },
        {
          "action": "click",
          "selector": "#recovery-journey button[data-action='cancel']"
        },
        {
          "action": "click",
          "selector": "dialog[open] form[data-form='cancel'] button[type='submit']"
        },
        {
          "action": "assertVisible",
          "selector": "#recovery-journey[data-state='matching']"
        },
        {
          "action": "click",
          "selector": "#recovery-journey button[data-action='review-matches']"
        },
        {
          "action": "assertText",
          "selector": ".matches-header strong",
          "value": "2 eligible patients"
        },
        {
          "action": "assertText",
          "selector": ".candidate.best h3",
          "value": "Alex Morgan"
        },
        {
          "action": "click",
          "selector": ".match-card details.excluded summary"
        },
        {
          "action": "assertVisible",
          "value": "Available Tue 09:00–12:00"
        },
        {
          "action": "click",
          "selector": "button[data-action='send-offer'][data-id='alex'][data-slot='slot-1500']"
        },
        {
          "action": "assertVisible",
          "selector": "#recovery-journey[data-state='pending']"
        },
        {
          "action": "click",
          "selector": "#recovery-journey button[data-action='preview-offer']"
        },
        {
          "action": "click",
          "selector": "button[data-action='accept']"
        },
        {
          "action": "assertText",
          "selector": ".response-confirmation",
          "value": "Confirmed for Alex Morgan. No further action needed."
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/?verification=booking#overview"
        },
        {
          "action": "assertVisible",
          "selector": "#recovery-journey[data-state='filled']"
        },
        {
          "action": "assertText",
          "selector": ".journey-banner h2",
          "value": "Alex Morgan is on the calendar."
        }
      ],
      "success": {
        "requiredUrlPattern": "^https://abarisuzuner[.]github[.]io/cancellation-backfil/[?]verification=booking#overview$",
        "allowedUrlPatterns": [],
        "allText": [
          "Alex Morgan is on the calendar.",
          "Alex Morgan is booked.",
          "Confirmed booking",
          "Refilled",
          "$75",
          "1 appointment backfilled · estimated"
        ],
        "anyText": [],
        "visibleSelectors": [
          "#recovery-journey[data-state='filled']",
          "#recovery-status",
          ".filled-state"
        ]
      }
    },
    {
      "id": "review-and-save-extracted-availability",
      "name": "Create a patient from a scheduling note",
      "purpose": "Prove that the local parser extracts preferences different from the form defaults, requires explicit review, and saves a searchable record that survives navigation.",
      "startPath": "/cancellation-backfil/#settings",
      "steps": [
        {
          "action": "goto",
          "value": "/cancellation-backfil/#settings"
        },
        {
          "action": "click",
          "selector": "button[data-action='reset']"
        },
        {
          "action": "click",
          "selector": "dialog[open] form[data-form='reset'] button[type='submit']"
        },
        {
          "action": "assertVisible",
          "selector": "#recovery-journey[data-state='booked']"
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/#waitlist"
        },
        {
          "action": "click",
          "selector": "button[data-action='new-patient']"
        },
        {
          "action": "fill",
          "selector": "#patient-form input[name='name']",
          "value": "AI Judge Sample Patient"
        },
        {
          "action": "fill",
          "selector": "#scheduling-note",
          "value": "Thursdays 10am to 12pm, 30 minutes notice"
        },
        {
          "action": "click",
          "selector": "#patient-form button[data-action='extract']"
        },
        {
          "action": "assertText",
          "selector": "#parser-result h4",
          "value": "Here’s what the local parser found"
        },
        {
          "action": "assertVisible",
          "value": "10:00–12:00"
        },
        {
          "action": "assertText",
          "selector": "#parser-result .parser-draft p",
          "value": "Review these values before applying them."
        },
        {
          "action": "click",
          "selector": "#patient-form button[data-action='apply-draft']"
        },
        {
          "action": "assertText",
          "selector": "#parser-result .draft-applied",
          "value": "Draft applied. Review the fields below, then save to confirm."
        },
        {
          "action": "click",
          "selector": "#patient-form button[type='submit']"
        },
        {
          "action": "waitForText",
          "value": "Patient preferences saved."
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/?verification=waitlist#waitlist"
        },
        {
          "action": "fill",
          "selector": "#patient-search",
          "value": "AI Judge Sample Patient"
        },
        {
          "action": "assertText",
          "selector": "#patient-rows .patient-cell strong",
          "value": "AI Judge Sample Patient"
        },
        {
          "action": "assertText",
          "selector": "#patient-rows .patient-cell small",
          "value": "Physiotherapy · 30 min"
        }
      ],
      "success": {
        "requiredUrlPattern": "^https://abarisuzuner[.]github[.]io/cancellation-backfil/[?]verification=waitlist#waitlist$",
        "allowedUrlPatterns": [],
        "allText": [
          "AI Judge Sample Patient",
          "Physiotherapy · 30 min",
          "Thu",
          "10:00–12:00",
          "30 min notice"
        ],
        "anyText": [],
        "visibleSelectors": [
          "#patient-rows",
          "button[aria-label='Edit AI Judge Sample Patient']",
          "button[aria-label='Pause AI Judge Sample Patient']"
        ]
      }
    },
    {
      "id": "expired-offer-next-patient-and-decline",
      "name": "Handle expiry and decline without a false booking",
      "purpose": "Prove that an expired offer closes, the next eligible patient can receive an offer, and a decline leaves the slot open with manual-follow-up guidance and zero recovered value.",
      "startPath": "/cancellation-backfil/#settings",
      "steps": [
        {
          "action": "goto",
          "value": "/cancellation-backfil/#settings"
        },
        {
          "action": "click",
          "selector": "button[data-action='reset']"
        },
        {
          "action": "click",
          "selector": "dialog[open] form[data-form='reset'] button[type='submit']"
        },
        {
          "action": "click",
          "selector": "#recovery-journey button[data-action='cancel']"
        },
        {
          "action": "click",
          "selector": "dialog[open] form[data-form='cancel'] button[type='submit']"
        },
        {
          "action": "click",
          "selector": "button[data-action='send-offer'][data-id='alex'][data-slot='slot-1500']"
        },
        {
          "action": "assertVisible",
          "selector": "#recovery-journey[data-state='pending']"
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/#settings"
        },
        {
          "action": "click",
          "selector": "button[data-action='advance-clock']"
        },
        {
          "action": "waitForText",
          "value": "Clinic clock advanced by three minutes."
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/#inbox"
        },
        {
          "action": "waitForText",
          "value": "Expired"
        },
        {
          "action": "click",
          "selector": "a[href^='#offer/']"
        },
        {
          "action": "assertText",
          "selector": ".response-confirmation",
          "value": "This offer is closed."
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/#overview"
        },
        {
          "action": "assertText",
          "selector": "#recovery-status",
          "value": "Alex Morgan's offer expired. 1 of 6 waitlist entries can attend. Review the reasons and choose a patient below."
        },
        {
          "action": "assertText",
          "selector": ".candidate.best h3",
          "value": "Sam Rivera"
        },
        {
          "action": "click",
          "selector": "button[data-action='send-offer'][data-id='sam'][data-slot='slot-1500']"
        },
        {
          "action": "click",
          "selector": "#recovery-journey button[data-action='preview-offer']"
        },
        {
          "action": "click",
          "selector": "button[data-action='decline']"
        },
        {
          "action": "waitForText",
          "value": "You’ve declined this appointment. You’ll remain on the waitlist for another opening."
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/?verification=followup#overview"
        },
        {
          "action": "assertVisible",
          "selector": "#recovery-journey[data-state='manual']"
        },
        {
          "action": "assertText",
          "selector": "#recovery-status",
          "value": "Sam Rivera's offer was declined. No suitable patient remains for this opening. Keep the appointment open and review preferences or follow up manually."
        },
        {
          "action": "assertText",
          "selector": ".match-card .empty-state h3",
          "value": "No eligible match right now"
        }
      ],
      "success": {
        "requiredUrlPattern": "^https://abarisuzuner[.]github[.]io/cancellation-backfil/[?]verification=followup#overview$",
        "allowedUrlPatterns": [],
        "allText": [
          "No eligible match right now",
          "Keep the slot open for manual follow-up, or review the waitlist preferences.",
          "Open slot",
          "$0",
          "0 appointments backfilled · estimated"
        ],
        "anyText": [],
        "visibleSelectors": [
          "#recovery-journey[data-state='manual']",
          ".match-card .empty-state",
          ".match-card a[href='#waitlist']"
        ]
      }
    }
  ],
  "manualReviewTriggers": []
}

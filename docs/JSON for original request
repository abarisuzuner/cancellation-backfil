{
  "appName": "Cancellation Backfill",
  "baseUrl": "https://abarisuzuner.github.io/cancellation-backfil/",
  "auth": {
    "required": false,
    "loginPath": "",
    "username": "",
    "password": "",
    "usernameSelector": "",
    "passwordSelector": "",
    "submitSelector": "",
    "successUrlPattern": "",
    "successText": []
  },
  "globalRules": {
    "maxStepTimeSeconds": 45,
    "waitForNetworkIdle": false,
    "notes": [
      "Set submission.demoUrl to https://abarisuzuner.github.io/cancellation-backfil/ before submitting. The pasted APP DETAILS currently leaves it null.",
      "Run in a dedicated browser context containing only disposable sample data. Each workflow resets the fictional clinic workspace.",
      "Preserve browser storage throughout each workflow. Staff screens and patient previews must use the same browser context.",
      "Keep all navigation on https://abarisuzuner.github.io and preserve the /cancellation-backfil/ path prefix.",
      "Query parameters in persistence checks force a document navigation while retaining saved records.",
      "Offers expire after two minutes. Complete acceptance promptly. Use the simulated clock control to test expiry.",
      "Do not assert a fixed elapsed booking time.",
      "The availability assistant uses deterministic local parsing. Live AI, Oracle persistence, external notifications, and cross-device access are not connected."
    ]
  },
  "workflows": [
    {
      "id": "cancel-match-accept-persist",
      "name": "Recover a cancelled appointment",
      "purpose": "Verify eligibility explanations, an offer to the highest-ranked patient, acceptance, recovered appointment value, and persistence.",
      "startPath": "/cancellation-backfil/#settings",
      "steps": [
        {
          "action": "goto",
          "value": "/cancellation-backfil/#settings"
        },
        {
          "action": "assertVisible",
          "selector": "#settings-form"
        },
        {
          "action": "click",
          "selector": "button[data-action='reset']"
        },
        {
          "action": "click",
          "selector": "dialog[open] form[data-form='reset'] button[type='submit']"
        },
        {
          "action": "waitForUrl",
          "value": "/cancellation-backfil/#overview"
        },
        {
          "action": "click",
          "selector": "button[aria-label='Cancel 15:00 appointment']"
        },
        {
          "action": "click",
          "selector": "dialog[open] form[data-form='cancel'] button[type='submit']"
        },
        {
          "action": "assertText",
          "selector": ".matches-header strong",
          "value": "2 eligible patients"
        },
        {
          "action": "assertText",
          "selector": ".candidate.best h3",
          "value": "Alex Morgan"
        },
        {
          "action": "click",
          "selector": ".match-card details.excluded summary"
        },
        {
          "action": "assertVisible",
          "value": "Available Tue 09:00–12:00"
        },
        {
          "action": "click",
          "selector": "button[data-action='send-offer'][data-id='alex'][data-slot='slot-1500']"
        },
        {
          "action": "waitForText",
          "value": "Waiting for a reply"
        },
        {
          "action": "click",
          "selector": ".match-card a[href^='#offer/']"
        },
        {
          "action": "assertVisible",
          "selector": "button[data-action='accept']"
        },
        {
          "action": "click",
          "selector": "button[data-action='accept']"
        },
        {
          "action": "assertText",
          "selector": ".response-confirmation",
          "value": "Confirmed for Alex Morgan. No further action needed."
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/?verification=booking#overview"
        },
        {
          "action": "assertText",
          "selector": ".journey-banner h2",
          "value": "Alex Morgan is on the calendar."
        },
        {
          "action": "assertVisible",
          "selector": ".filled-state"
        }
      ],
      "success": {
        "requiredUrlPattern": "^https://abarisuzuner[.]github[.]io/cancellation-backfil/[?]verification=booking#overview$",
        "allowedUrlPatterns": [],
        "allText": [
          "Alex Morgan is on the calendar.",
          "Alex Morgan is booked.",
          "Refilled",
          "$75",
          "1 appointment backfilled · estimated"
        ],
        "anyText": [],
        "visibleSelectors": [
          "#main-content",
          ".filled-state",
          "button[aria-label='Cancel 15:00 appointment']"
        ]
      }
    },
    {
      "id": "parse-review-save-preferences",
      "name": "Create a patient from a scheduling note",
      "purpose": "Verify preference extraction, explicit review, and a saved patient record that survives navigation.",
      "startPath": "/cancellation-backfil/#settings",
      "steps": [
        {
          "action": "goto",
          "value": "/cancellation-backfil/#settings"
        },
        {
          "action": "click",
          "selector": "button[data-action='reset']"
        },
        {
          "action": "click",
          "selector": "dialog[open] form[data-form='reset'] button[type='submit']"
        },
        {
          "action": "waitForUrl",
          "value": "/cancellation-backfil/#overview"
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/#waitlist"
        },
        {
          "action": "click",
          "selector": "button[data-action='new-patient']"
        },
        {
          "action": "fill",
          "selector": "#patient-form input[name='name']",
          "value": "AI Judge Sample Patient"
        },
        {
          "action": "fill",
          "selector": "#scheduling-note",
          "value": "Thursdays 10am to 12pm, 30 minutes notice"
        },
        {
          "action": "click",
          "selector": "#patient-form button[data-action='extract']"
        },
        {
          "action": "assertText",
          "selector": "#parser-result h4",
          "value": "Here’s what the local parser found"
        },
        {
          "action": "assertVisible",
          "value": "10:00–12:00"
        },
        {
          "action": "assertText",
          "selector": "#parser-result .parser-draft p",
          "value": "Review these values before applying them."
        },
        {
          "action": "click",
          "selector": "#patient-form button[data-action='apply-draft']"
        },
        {
          "action": "assertText",
          "selector": "#parser-result .draft-applied",
          "value": "Draft applied. Review the fields below, then save to confirm."
        },
        {
          "action": "click",
          "selector": "#patient-form button[type='submit']"
        },
        {
          "action": "waitForText",
          "value": "Patient preferences saved."
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/?verification=waitlist#waitlist"
        },
        {
          "action": "fill",
          "selector": "#patient-search",
          "value": "AI Judge Sample Patient"
        },
        {
          "action": "assertText",
          "selector": "#patient-rows .patient-cell strong",
          "value": "AI Judge Sample Patient"
        },
        {
          "action": "assertText",
          "selector": "#patient-rows .patient-cell small",
          "value": "Physiotherapy · 30 min"
        }
      ],
      "success": {
        "requiredUrlPattern": "^https://abarisuzuner[.]github[.]io/cancellation-backfil/[?]verification=waitlist#waitlist$",
        "allowedUrlPatterns": [],
        "allText": [
          "AI Judge Sample Patient",
          "Physiotherapy · 30 min",
          "Thu",
          "10:00–12:00",
          "30 min notice"
        ],
        "anyText": [],
        "visibleSelectors": [
          "#patient-rows",
          "button[aria-label='Edit AI Judge Sample Patient']",
          "button[aria-label='Pause AI Judge Sample Patient']"
        ]
      }
    },
    {
      "id": "expiry-decline-manual-follow-up",
      "name": "Handle unsuccessful offers",
      "purpose": "Verify expiry, an offer to the next eligible patient, and manual-follow-up guidance after a decline leaves no eligible candidates.",
      "startPath": "/cancellation-backfil/#settings",
      "steps": [
        {
          "action": "goto",
          "value": "/cancellation-backfil/#settings"
        },
        {
          "action": "click",
          "selector": "button[data-action='reset']"
        },
        {
          "action": "click",
          "selector": "dialog[open] form[data-form='reset'] button[type='submit']"
        },
        {
          "action": "waitForUrl",
          "value": "/cancellation-backfil/#overview"
        },
        {
          "action": "click",
          "selector": "button[aria-label='Cancel 15:00 appointment']"
        },
        {
          "action": "click",
          "selector": "dialog[open] form[data-form='cancel'] button[type='submit']"
        },
        {
          "action": "click",
          "selector": "button[data-action='send-offer'][data-id='alex'][data-slot='slot-1500']"
        },
        {
          "action": "waitForText",
          "value": "Waiting for a reply"
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/#settings"
        },
        {
          "action": "click",
          "selector": "button[data-action='advance-clock']"
        },
        {
          "action": "waitForText",
          "value": "Clinic clock advanced by three minutes."
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/#inbox"
        },
        {
          "action": "waitForText",
          "value": "Expired"
        },
        {
          "action": "click",
          "selector": "a[href^='#offer/']"
        },
        {
          "action": "waitForText",
          "value": "The response window has closed. The clinic can now offer this appointment to another patient."
        },
        {
          "action": "assertText",
          "selector": ".response-confirmation",
          "value": "This offer is closed."
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/#overview"
        },
        {
          "action": "assertText",
          "selector": ".candidate.best h3",
          "value": "Sam Rivera"
        },
        {
          "action": "click",
          "selector": "button[data-action='send-offer'][data-id='sam'][data-slot='slot-1500']"
        },
        {
          "action": "waitForText",
          "value": "Waiting for a reply"
        },
        {
          "action": "click",
          "selector": ".match-card a[href^='#offer/']"
        },
        {
          "action": "click",
          "selector": "button[data-action='decline']"
        },
        {
          "action": "waitForText",
          "value": "You’ve declined this appointment. You’ll remain on the waitlist for another opening."
        },
        {
          "action": "goto",
          "value": "/cancellation-backfil/#overview"
        },
        {
          "action": "assertText",
          "selector": ".match-card .empty-state h3",
          "value": "No eligible match right now"
        }
      ],
      "success": {
        "requiredUrlPattern": "^https://abarisuzuner[.]github[.]io/cancellation-backfil/#overview$",
        "allowedUrlPatterns": [],
        "allText": [
          "No eligible match right now",
          "Keep the slot open for manual follow-up, or review the waitlist preferences.",
          "Open slot",
          "Review waitlist",
          "$0",
          "0 appointments backfilled · estimated"
        ],
        "anyText": [],
        "visibleSelectors": [
          ".match-card .empty-state",
          ".match-card a[href='#waitlist']"
        ]
      }
    }
  ],
  "manualReviewTriggers": []
}
